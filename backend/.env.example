# OBC Software — Environment Variable Template
# Copy this file to .env before starting the production deployment

# Database Configuration
DATABASE_URL="postgresql://postgres:YOUR_SECURE_PASSWORD@localhost:5433/co_po_attainment?schema=public"

# Gateway & Service Settings
PORT=3001
NODE_ENV=production

# Security & Authentication Secrets
# Generate a strong 64-char key (e.g. `openssl rand -hex 32`)
JWT_SECRET="your_strong_random_jwt_secret_key_here"

# Allowed CORS Origins (Comma separated)
ALLOWED_ORIGINS="http://localhost:3001,https://yourdomain.com"

# AI Syllabus Extraction API Key (Optional)
GEMINI_API_KEY=""
