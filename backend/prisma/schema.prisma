generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Faculty {
  id         String   @id @default(uuid())
  name       String
  email      String?  @unique
  department String?
  misNumber  String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  courses    Course[]

  @@map("faculty")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   @default("password")
  role      String   @default("admin")
  name      String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  courseAccesses CourseAccess[]

  @@map("app_user")
}

model Course {
  id             String          @id @default(uuid())
  courseId       String          @unique
  name           String
  code           String?
  courseType     String?
  department     String?
  semester       String?
  credits        Float?
  lectureHrs     Int?
  tutorialHrs    Int?
  practicalHrs   Int?
  selfStudyHrs   Int?
  academicYear   String?
  programName    String?
  misNumber      String?
  totalStudents  Int?
  theoryMSE      Int?
  theoryTE       Int?
  theoryESE      Int?
  labISE         Int?
  labESE         Int?
  facultyId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teachingPlan   Json?
  units          Json?
  pedagogyTools  Json?
  references     Json?
  settings       Json?
  coTargetPct    Int?            @default(60)
  directWeight   Int?            @default(80)
  indirectWeight Int?            @default(20)
  attendance     Attendance[]
  faculty        Faculty?        @relation(fields: [facultyId], references: [id])
  courseAccesses CourseAccess[]
  courseOutcomes CourseOutcome[]
  enrollments    Enrollment[]
  exams          Exam[]
  questionPapers QuestionPaper[]

  @@map("course")
}

model CourseOutcome {
  id                     String                  @id @default(uuid())
  courseId               String
  coNumber               String
  description            String
  bloomLevel             String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  copoMappings           COPOMapping[]
  course                 Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  feedbacks              Feedback[]
  marks                  Mark[]
  questions              Question[]
  questionPaperQuestions QuestionPaperQuestion[]

  @@unique([courseId, coNumber])
  @@map("course_outcome")
}

model PO {
  id           String        @id @default(uuid())
  poId         String        @unique
  description  String
  type         String
  copoMappings COPOMapping[]

  @@map("po")
}

model COPOMapping {
  id               String        @id @default(uuid())
  courseOutcomeId  String
  poId             String
  correlationLevel Int
  courseOutcome    CourseOutcome @relation(fields: [courseOutcomeId], references: [id], onDelete: Cascade)
  po               PO            @relation(fields: [poId], references: [id])

  @@unique([courseOutcomeId, poId])
  @@map("copo_mapping")
}

model Student {
  id           String       @id @default(uuid())
  rollNumber   String       @unique
  name         String
  email        String?
  batchYear    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  misNumber    String?      @unique
  mobile       String?
  semester     String?
  academicYear String?
  attendance   Attendance[]
  enrollments  Enrollment[]
  feedbacks    Feedback[]
  marks        Mark[]

  @@map("student")
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@map("enrollment")
}

model Exam {
  id           String     @id @default(uuid())
  courseId     String
  title        String
  type         String
  totalMarks   Int
  date         DateTime?
  duration     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  misNumber    String?
  academicYear String?
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]

  @@map("exam")
}

model Question {
  id              String         @id @default(uuid())
  examId          String
  label           String
  subQuestion     String?
  maxMarks        Float
  courseOutcomeId String?
  bloomLevel      String?
  unitNo          String?
  questionText    String?
  createdAt       DateTime       @default(now())
  marks           Mark[]
  courseOutcome   CourseOutcome? @relation(fields: [courseOutcomeId], references: [id])
  exam            Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("question")
}

model Mark {
  id              String         @id @default(uuid())
  studentId       String
  questionId      String
  courseOutcomeId String?
  marksObtained   Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  academicYear    String?
  examType        String?
  misNumber       String?
  courseOutcome   CourseOutcome? @relation(fields: [courseOutcomeId], references: [id])
  question        Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionId])
  @@map("mark")
}

model Feedback {
  id              String         @id @default(uuid())
  studentId       String?
  courseOutcomeId String?
  rating          Int
  createdAt       DateTime       @default(now())
  category        String?
  text            String?
  courseOutcome   CourseOutcome? @relation(fields: [courseOutcomeId], references: [id])
  student         Student?       @relation(fields: [studentId], references: [id])

  @@map("feedback")
}

model QuestionPaper {
  id         String                  @id @default(uuid())
  courseId   String
  title      String
  type       String
  totalMarks Int
  date       String?
  duration   String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  course     Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions  QuestionPaperQuestion[]

  @@map("question_paper")
}

model QuestionPaperQuestion {
  id              String         @id @default(uuid())
  paperId         String
  section         String?
  label           String?
  subQuestion     String?
  questionText    String
  marks           Int
  type            String?
  courseOutcomeId String?
  bloomLevel      String?
  createdAt       DateTime       @default(now())
  courseOutcome   CourseOutcome? @relation(fields: [courseOutcomeId], references: [id])
  paper           QuestionPaper  @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@map("question_paper_question")
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  key       String
  status    String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, key])
  @@map("attendance")
}

model AcademicPlan {
  id             String   @id @default(uuid())
  department     String   @unique @default("default")
  academicYears  Json?
  versions       Json?
  programs       Json?
  faculty        Json?
  timetable      Json?
  framework      Json?
  calendar       Json?
  exportSettings Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("academic_plan")
}

model CourseAccess {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  accessLevel String   @default("owner")
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_access")
}
